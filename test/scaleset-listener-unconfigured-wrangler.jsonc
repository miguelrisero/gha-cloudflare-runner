{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "scaleset-listener-unconfigured-regression-test",
  "main": "scaleset-listener-harness.js",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "CONTROL_TOKEN": "control-token-with-at-least-32-characters",
    "GITHUB_REPOSITORY": "example/runner-test",
    "GITHUB_TOKEN": "github-token-secret",
    "RUNNER_LABELS": "cloudflare-sandbox"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ScaleSetListener",
        "class_name": "ScaleSetListener"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ScaleSetListener"]
    }
  ]
}
