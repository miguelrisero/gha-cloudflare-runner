{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "runner-registry-regression-test",
  "main": "runner-registry-harness.js",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "CONTROL_TOKEN": "control-token-with-at-least-32-characters",
    "GITHUB_REPOSITORY": "example/runner-test",
    "GITHUB_TOKEN": "github-token",
    "RUNNER_LABELS": "cloudflare-sandbox"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AutopilotControl",
        "class_name": "AutopilotControl"
      },
      {
        "name": "RunnerRegistry",
        "class_name": "RunnerRegistry"
      },
      {
        "name": "Sandbox",
        "class_name": "RunnerRegistry"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AutopilotControl", "RunnerRegistry"]
    }
  ]
}
